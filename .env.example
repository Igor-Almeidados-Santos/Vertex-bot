# ==============================================================================
# VERTEX-BOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Execution Mode: PAPER (simulation/virtual balance) or LIVE (real transactions)
EXECUTION_MODE=PAPER
CONFIRM_LIVE_TRADING=false

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Scanner Ingestion Provider: INDEXED (Photon/DexScreener high-speed feed) or RAW_RPC
SCANNER_PROVIDER=INDEXED
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
DEXSCREENER_POLL_INTERVAL_SEC=2.0

# Execution & Routing APIs (Jupiter Swap v6 & Jito)
JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_API_URL=https://quote-api.jup.ag/v6/swap
# HELIUS_API_KEY=

# Network & RPC Endpoints (Solana Fallback)
PRIMARY_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SECONDARY_RPC_HTTP_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR-KEY
PRIMARY_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Local Database Configuration
SQLITE_DB_PATH=data/vertex_bot.db

# Paper Trading Parameters
PAPER_INITIAL_BALANCE_SOL=10.0
PAPER_SIMULATED_LATENCY_MS=250
PAPER_DEFAULT_BUY_AMOUNT_SOL=0.1

# Risk Management & Protection Parameters
MAX_SLIPPAGE_PCT=1.5
MIN_LIQUIDITY_USD=5000.0
MAX_LIQUIDITY_USD=250000.0
MAX_TOP10_HOLDERS_PCT=15.0
MAX_BUY_TAX_PCT=3.0
MAX_SELL_TAX_PCT=3.0
BREAK_EVEN_GAIN_PCT=100.0
TRAILING_STOP_DROP_PCT=12.0
EMERGENCY_STOP_LOSS_PCT=20.0
MAX_DAILY_DRAWDOWN_PCT=8.0

# Live Trading Keypair (REQUIRED ONLY IN LIVE MODE - NEVER COMMIT REAL KEYS)
# WALLET_PRIVATE_KEY_BASE58=
